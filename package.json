{
  "name": "opencode-remote-code",
  "version": "0.1.0",
  "description": "OpenCode plugin for remote machine control over SSH",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-remote": "bin/opencode-remote.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "scripts/setup.cjs",
    "launchers"
  ],
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "remote": "node bin/opencode-remote.cjs",
    "unregister": "node scripts/setup.cjs --unregister",
    "test:local": "npm run build && node --test tests/local.test.mjs",
    "test:cli": "npm run build && node --test tests/cli.test.mjs tests/prompt.test.mjs",
    "build": "tsc",
    "postbuild": "node scripts/postbuild.cjs",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ssh2": "^1.17.0",
    "zod": "^3.22.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zz6zz666/opencode-remote-code.git"
  },
  "bugs": {
    "url": "https://github.com/zz6zz666/opencode-remote-code/issues"
  },
  "homepage": "https://github.com/zz6zz666/opencode-remote-code#readme",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "ssh",
    "remote",
    "agent"
  ]
}
